#!/usr/bin/env sh
# Dev launcher shim: sync the in-tree plugin into `dist/plugin/` and prepend
# `--plugin-dir <repo root>/dist/plugin`, so the plugin is active without
# remembering the flag. Loading the copy rather than `plugin/` itself keeps
# `plugin/` editable: Claude Code flags every path under a loaded plugin root
# as a sensitive file, ahead of acceptEdits and allow rules. Edits reach the
# copy at the next launch. On PATH via `.envrc` (`PATH_add .bin`). Chains to
# the next `claude` on PATH (e.g. gitlore's launcher shim) with our own dir
# stripped from PATH — the gitlore shim resolves *its* next claude against the
# inherited PATH, so leaving ourselves on it would make the two shims exec each
# other forever.

self=$(cd "$(dirname "$0")" && pwd)
root=$(dirname "$self")
if ! { mkdir -p "$root/dist" && rsync -a --delete "$root/plugin/" "$root/dist/plugin/"; }; then
  echo "claude shim: cannot sync plugin/ into dist/plugin/" >&2
  exit 1
fi
newpath=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$self" | paste -sd: -)
real=$(PATH="$newpath" command -v claude) \
  || { echo "claude shim: no real claude on PATH" >&2; exit 127; }
PATH="$newpath" exec "$real" --plugin-dir "$root/dist/plugin" "$@"

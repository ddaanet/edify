#!/usr/bin/env python3
"""Fix structural issues in Claude-generated markdown, in place.

Reads markdown file paths from stdin, one per line, rewrites each file that a
fix changes and prints the path of each rewritten file. Reports non-.md and
missing paths on stderr and exits 1 after processing every valid path.

Fixes: keyword lists lacking bullets, inline triple backticks, dunder names in
headings, metadata labels, numbered-list spacing, lettered sub-items, spaced
backtick spans, and ```markdown blocks that contain inner fences. Fenced code
and YAML prologs are protected; ```markdown blocks are processed inside.
"""

import re
import sys
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path


def main() -> int:
    """Process the markdown files named on stdin."""
    files = [line.strip() for line in sys.stdin if line.strip()]
    errors: list[str] = []
    valid_files: list[Path] = []
    for name in files:
        path = Path(name)
        if path.suffix != ".md":
            errors.append(f"Error: {name} is not a markdown file")
        elif not path.exists():
            errors.append(f"Error: {name} does not exist")
        else:
            valid_files.append(path)
    for path in valid_files:
        if process_file(path):
            print(str(path))
    for error in errors:
        print(error, file=sys.stderr)
    return 1 if errors else 0


def process_file(filepath: Path) -> bool:
    """Process a markdown file, returning True if modified."""
    with filepath.open(encoding="utf-8") as f:
        original_lines = f.readlines()
    lines = process_lines(original_lines)
    if lines == original_lines:
        return False
    with filepath.open("w", encoding="utf-8") as f:
        f.writelines(lines)
    return True


def process_lines(lines: list[str]) -> list[str]:
    """Apply all markdown structure fixes to lines."""
    segments = parse_segments(lines)
    for fix in (
        escape_inline_backticks,
        lambda ls: [fix_dunder_references(line) for line in ls],
        fix_metadata_blocks,
        fix_warning_lines,
        fix_nested_lists,
        fix_numbered_list_spacing,
        fix_backtick_spaces,
    ):
        segments = apply_fix_to_segments(segments, fix)
    return fix_markdown_code_blocks(flatten_segments(segments))


# ruff: noqa: FBT003

# --- Segments: processable text versus protected code and YAML prologs -------


@dataclass
class Segment:
    """A segment of a markdown document, processable or protected."""

    processable: bool
    language: str | None
    lines: list[str]
    start_line: int


def parse_segments(lines: list[str]) -> list[Segment]:
    """Parse a document into processable and protected segments."""
    segments: list[Segment] = []
    i = 0
    while i < len(lines):
        stripped = lines[i].strip()
        if stripped == "---":
            prolog, next_idx = _try_parse_yaml_prolog(lines, i)
            if prolog:
                segments.append(prolog)
                i = next_idx
                continue
        if stripped.startswith("```"):
            new_segments, i = _parse_fenced_block(lines, i)
            segments.extend(new_segments)
            continue
        text_lines, next_idx = _collect_plain_text(lines, i)
        if text_lines:
            segments.append(Segment(True, None, text_lines, i))
        i = next_idx
    return segments


def flatten_segments(segments: list[Segment]) -> list[str]:
    """Flatten segments back into a list of lines."""
    return [line for segment in segments for line in segment.lines]


def apply_fix_to_segments(
    segments: list[Segment], fix_fn: Callable[[list[str]], list[str]]
) -> list[Segment]:
    """Apply a fix to processable segments only; protected ones pass through."""
    return [
        Segment(s.processable, s.language, fix_fn(s.lines), s.start_line)
        if s.processable
        else s
        for s in segments
    ]


def _try_parse_yaml_prolog(
    lines: list[str], start_idx: int
) -> tuple[Segment | None, int]:
    """Parse a YAML prolog at start_idx; return (segment or None, new index)."""
    prolog_lines = [lines[start_idx]]
    j = start_idx + 1
    has_key_value = False
    found_closing = False
    if not (j < len(lines) and lines[j].strip()):
        return None, start_idx
    while j < len(lines):
        stripped = lines[j].strip()
        if not stripped:
            return None, start_idx
        prolog_lines.append(lines[j])
        j += 1
        if stripped == "---":
            found_closing = True
            break
        if re.match(r"^[a-zA-Z_][\w-]*:", stripped):
            has_key_value = True
    if found_closing and has_key_value:
        return Segment(False, "yaml-prolog", prolog_lines, start_idx), j
    return None, start_idx


def _extract_fence_info(line: str) -> tuple[int, str | None]:
    """Return the leading backtick count and the language of a fence line."""
    count = len(line) - len(line.lstrip("`"))
    return count, line[count:].strip() or None


def _find_fenced_block_end(
    lines: list[str], start_idx: int, backtick_count: int
) -> tuple[list[str], int]:
    """Find the end of a fenced block, tracking same-width nested openings."""
    fence_lines = [lines[start_idx]]
    i = start_idx + 1
    depth = 1
    while i < len(lines) and depth:
        stripped = lines[i].strip()
        fence_lines.append(lines[i])
        if stripped.startswith("```"):
            count, language = _extract_fence_info(stripped)
            if count == backtick_count:
                if language:
                    depth += 1
                else:
                    depth -= 1
                    if not depth:
                        i += 1
                        break
        i += 1
    return fence_lines, i


def _parse_fenced_block(lines: list[str], start_idx: int) -> tuple[list[Segment], int]:
    """Parse a fenced block; only ```markdown blocks are processable."""
    backtick_count, language = _extract_fence_info(lines[start_idx].strip())
    fence_lines, end_idx = _find_fenced_block_end(lines, start_idx, backtick_count)
    first = end_idx - len(fence_lines)
    processable = language == "markdown"
    if not processable or len(fence_lines) <= 2:
        return [Segment(processable, language, fence_lines, first)], end_idx
    inner_segments = parse_segments(fence_lines[1:-1])
    for seg in inner_segments:
        seg.start_line += first + 1
    return [
        Segment(True, language, [fence_lines[0]], first),
        *inner_segments,
        Segment(True, language, [fence_lines[-1]], end_idx - 1),
    ], end_idx


def _collect_plain_text(lines: list[str], start_idx: int) -> tuple[list[str], int]:
    """Collect plain text until the next fence or YAML prolog."""
    text_lines: list[str] = []
    i = start_idx
    while i < len(lines):
        stripped = lines[i].strip()
        if text_lines and stripped.startswith("```"):
            break
        if (
            text_lines
            and stripped == "---"
            and i + 1 < len(lines)
            and lines[i + 1].strip()
        ):
            break
        text_lines.append(lines[i])
        i += 1
    return text_lines, i


# --- Inline fixes: dunder names and triple backticks -------------------------


def fix_dunder_references(line: str) -> str:
    """Wrap __name__.py in backticks within headings."""
    if line.startswith("#"):
        line = re.sub(r"(?<!`)(__[A-Za-z0-9_]+__(\.py)?)(?!`)", r"`\1`", line)
    return line


def find_inline_code_spans(line: str) -> list[tuple[int, int]]:
    """Find inline code spans delimited by 1 or 2 backticks, as (start, end).

    A span closes at a backtick run of exactly the opening length. Runs of 3 or
    more are treated as fence markers, not spans, so that
    escape_inline_backticks escapes them.
    """
    spans = []
    i = 0
    while i < len(line):
        if line[i] != "`":
            i += 1
            continue
        start_pos = i
        while i < len(line) and line[i] == "`":
            i += 1
        delimiter_len = i - start_pos
        if delimiter_len > 2:
            continue
        search_pos = i
        found = False
        while search_pos < len(line):
            if line[search_pos] != "`":
                search_pos += 1
                continue
            run_start = search_pos
            while search_pos < len(line) and line[search_pos] == "`":
                search_pos += 1
            if search_pos - run_start == delimiter_len:
                spans.append((start_pos, search_pos))
                i = search_pos
                found = True
                break
        if not found:
            i = start_pos + delimiter_len
    return spans


def _escape_triple_backticks_in_line(line: str) -> str:
    """Wrap triple backticks in double backticks, leaving escaped ones alone."""
    pattern = r"`` (`{3,}\w*) ``|^\s*(`{3,}\w*) ``|(`{3,})(\w*)"

    def replacer(m: re.Match[str]) -> str:
        if m.group(1) or m.group(2):
            return m.group(0)
        return f"`` {m.group(3)}{m.group(4)} ``"

    return re.sub(pattern, replacer, line)


def escape_inline_backticks(lines: list[str]) -> list[str]:
    """Escape triple backticks that appear inline in text.

    Skips real fence lines and code blocks, protects inline code spans, and is
    idempotent.
    """
    result = []
    in_code_block = False
    for line in lines:
        if line.strip().startswith("```"):
            in_code_block = not in_code_block
            result.append(line)
            continue
        if in_code_block:
            result.append(line)
            continue
        parts = []
        pos = 0
        for start, end in find_inline_code_spans(line):
            if pos < start:
                parts.append(_escape_triple_backticks_in_line(line[pos:start]))
            parts.append(line[start:end])
            pos = end
        if pos < len(line):
            parts.append(_escape_triple_backticks_in_line(line[pos:]))
        result.append("".join(parts))
    return result


# --- Block fix: nest ```markdown blocks holding inner fences -----------------


def _find_matching_close_fence(lines: list[str], start_idx: int) -> bool:
    """Return True if a closing ``` comes before any opening fence."""
    for k in range(start_idx + 1, len(lines)):
        check_line = lines[k].strip()
        if check_line == "```":
            return True
        if check_line.startswith("```") and len(check_line) > 3:
            return False
    return False


def _track_fence_depth(
    block_stripped: str, fence_depth: int, lines: list[str], idx: int
) -> int:
    """Return the new fence depth, or -1 at the outer closing fence."""
    if len(block_stripped) > 3:
        return fence_depth + 1
    if block_stripped == "```":
        if fence_depth > 0:
            return fence_depth - 1
        if _find_matching_close_fence(lines, idx):
            return fence_depth + 1
        return -1
    return fence_depth


def fix_markdown_code_blocks(lines: list[str]) -> list[str]:
    """Upgrade fenced blocks that contain inner ``` fences to 4 backticks."""
    result = []
    i = 0
    while i < len(lines):
        line = lines[i]
        stripped = line.strip()
        if not (stripped.startswith("```") and len(stripped) > 3):
            result.append(line)
            i += 1
            continue
        language = stripped[3:]
        block_lines = [line]
        j = i + 1
        fence_depth = 0
        while j < len(lines):
            block_lines.append(lines[j])
            block_stripped = lines[j].strip()
            if block_stripped.startswith("```"):
                new_depth = _track_fence_depth(block_stripped, fence_depth, lines, j)
                if new_depth == -1:
                    break
                fence_depth = new_depth
            j += 1
        else:
            result.extend(block_lines)
            i = j
            continue
        has_inner_fence = (
            any("```" in lines[k] for k in range(i + 1, j)) or fence_depth > 0
        )
        if has_inner_fence:
            result.extend([f"````{language}\n", *block_lines[1:-1], "````\n"])
        else:
            result.extend(block_lines)
        i = j + 1
    return result


# --- List fixes ---------------------------------------------------------------

_TREE_CHARS = ("├", "└", "│")


def _extract_prefix(line: str) -> str | None:
    """Return an emoji, [bracket] or UPPER: prefix of a non-list line, else None."""
    stripped = line.strip()
    if not stripped or re.match(r"^[-*]|^\d+\.", stripped):
        return None
    if stripped.startswith("|") and stripped.count("|") >= 2:
        return None
    if stripped.startswith(">") or any(sym in stripped[:3] for sym in _TREE_CHARS):
        return None
    for pattern in (
        r"^([^\w\s\[\(\{\-\*\|>`]+)(\s|$)",
        r"^(\[[^\]]+\])(\s|$)",
        r"^([A-Z][A-Z0-9_]*:)\s",
    ):
        match = re.match(pattern, stripped)
        if match:
            return match.group(1)
    return None


def _is_similar_prefix(p1: str | None, p2: str | None) -> bool:
    """Return True if two prefixes are equal or of the same kind."""
    if p1 is None or p2 is None:
        return False
    if p1 == p2:
        return True
    return (
        (_is_emoji(p1) and _is_emoji(p2))
        or (p1.startswith("[") and p2.startswith("["))
        or (p1.endswith(":") and p2.endswith(":"))
    )


def _is_emoji(prefix: str) -> bool:
    """Return True if the prefix is emoji-like."""
    return bool(re.match(r"^[^\w\s\[\(\{\-\*]", prefix))


def fix_warning_lines(lines: list[str]) -> list[str]:
    """Turn runs of 2+ lines with a similar emoji, [tag] or NOTE: prefix to bullets."""
    result = []
    i = 0
    while i < len(lines):
        prefix = _extract_prefix(lines[i])
        if prefix:
            j = i + 1
            while j < len(lines) and _is_similar_prefix(
                prefix, _extract_prefix(lines[j])
            ):
                j += 1
            if j - i >= 2:
                result.extend(f"- {line.strip()}\n" for line in lines[i:j])
                i = j
                continue
        result.append(lines[i])
        i += 1
    return result


def _collect_metadata_block(
    lines: list[str], start_idx: int, pattern: str
) -> tuple[list[str], int, bool]:
    """Collect consecutive metadata lines; return (lines, next index, blank after)."""
    metadata_lines = [lines[start_idx]]
    j = start_idx + 1
    found_blank = False
    while j < len(lines):
        if re.match(pattern, lines[j].strip()):
            metadata_lines.append(lines[j])
            j += 1
        elif lines[j].strip() == "":
            found_blank = True
            j += 1
            break
        else:
            break
    return metadata_lines, j, found_blank


def _indent_following_lists(lines: list[str], start_idx: int, result: list[str]) -> int:
    """Indent list items that follow a metadata block; return the next index."""
    j = start_idx
    while j < len(lines):
        stripped = lines[j].strip()
        if stripped == "":
            result.append(lines[j])
            j += 1
            break
        if not re.match(r"^[-*] |^\d+\. ", stripped):
            break
        result.append(f"  {stripped}\n")
        j += 1
    return j


def fix_metadata_blocks(lines: list[str]) -> list[str]:
    """Convert 2+ consecutive **Label:** lines to list items, indenting lists after."""
    result = []
    i = 0
    pattern = r"^\*\*[A-Za-z][^*]+:\*\*|^\*\*[A-Za-z][^*]+\*\*:"
    while i < len(lines):
        if re.match(pattern, lines[i].strip()):
            metadata_lines, j, found_blank = _collect_metadata_block(lines, i, pattern)
            if len(metadata_lines) >= 2:
                result.extend(
                    f"- {m.strip()}\n" for m in metadata_lines if m.strip()
                )
                if found_blank:
                    result.append("\n")
                i = _indent_following_lists(lines, j, result)
                continue
        result.append(lines[i])
        i += 1
    return result


def fix_numbered_list_spacing(lines: list[str]) -> list[str]:
    """Blank line before a numbered list after non-list text or **Label:**."""
    result: list[str] = []
    numbered = r"^[0-9]+\. \S"
    bullet = r"^[*+-] \S"
    label = r"^\*\*[^*]+:\*\*\s*$"
    in_numbered_list = False
    for i, line in enumerate(lines):
        stripped = line.strip()
        is_item = bool(re.match(numbered, stripped)) and not line.startswith("   ")
        is_blank = stripped == ""
        is_continuation = in_numbered_list and line.startswith("   ") and not is_blank
        if is_blank:
            in_numbered_list = False
        elif is_item:
            if not in_numbered_list and result:
                prev = result[-1].strip()
                if (
                    prev != ""
                    and not re.match(numbered, prev)
                    and not re.match(bullet, prev)
                    and not re.match(label, prev)
                ):
                    result.append("\n")
            in_numbered_list = True
        elif not is_continuation:
            in_numbered_list = False
        result.append(line)
        if re.match(label, stripped) and i + 1 < len(lines):
            nxt = lines[i + 1]
            if re.match(numbered, nxt.strip()) and not nxt.startswith("   "):
                result.append("\n")
    return result


def fix_nested_lists(lines: list[str]) -> list[str]:
    """Convert lettered sub-items (a., b., c.) to numbered lists."""
    result = []
    for line in lines:
        match = re.match(r"^([a-z])\.\s+(.+)$", line.strip())
        if match:
            indent = line[: len(line) - len(line.lstrip())]
            num = ord(match.group(1)) - ord("a") + 1
            result.append(f"{indent}{num}. {match.group(2)}\n")
        else:
            result.append(line)
    return result


def fix_backtick_spaces(lines: list[str]) -> list[str]:
    """Quote inline code that has leading or trailing spaces: `a ` becomes `"a "`.

    Lines holding escaped backticks (`` ``) are skipped.
    """

    def replace(match: re.Match[str]) -> str:
        content = match.group(1)
        if content and (content[0] == " " or content[-1] == " "):
            return f'`"{content}"`'
        return f"`{content}`"

    return [
        line
        if "`` " in line or " ``" in line
        else re.sub(r"`([^`]*)`", replace, line)
        for line in lines
    ]


def fix_metadata_list_indentation(lines: list[str]) -> list[str]:
    """Turn a **Label:** line before a list into a list item; indent that list."""
    result: list[str] = []
    i = 0
    label_pattern = r"^\*\*[^*]+:\*\*\s*$|^\*\*[^*]+\*\*:\s*$"
    while i < len(lines):
        line = lines[i]
        stripped = line.strip()
        indent = line[: len(line) - len(line.lstrip())]
        if (
            re.match(label_pattern, stripped)
            and i + 1 < len(lines)
            and re.match(r"^[-*]|^\d+\.", lines[i + 1].strip())
        ):
            result.append(f"{indent}- {stripped}\n")
            j = i + 1
            while j < len(lines):
                list_line = lines[j]
                list_stripped = list_line.strip()
                if list_stripped == "":
                    result.append(list_line)
                    j += 1
                    break
                if not re.match(r"^[-*]|^\d+\.", list_stripped):
                    break
                list_indent = list_line[: len(list_line) - len(list_line.lstrip())]
                result.append(f"{list_indent}  {list_stripped}\n")
                j += 1
            i = j
            continue
        result.append(line)
        i += 1
    return result


if __name__ == "__main__":
    sys.exit(main())
